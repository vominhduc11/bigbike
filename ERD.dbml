  "opted_out_at" timestamptz [not null]
  "created_at" timestamptz [not null]
  Note: "0 dòng - nhóm: Đánh giá sản phẩm"
}

Table review_photo_uploads {
  "object_key" varchar(500) [pk, not null]
  "public_url" varchar(600) [unique, not null]
  "product_id" varchar(64) [not null]
  "uploaded_at" timestamptz [not null]
  "claimed_at" timestamptz
  "review_id" bigint
  Note: "0 dòng - nhóm: Đánh giá sản phẩm"
}

Table reviews {
  "id" bigint [pk, not null]
  "product_id" varchar(64) [not null]
  "customer_id" uuid
  "author_name" varchar(255)
  "author_email" varchar(255)
  "rating" numeric [not null]
  "body" text
  "status" varchar(30) [not null]
  "legacy_id" bigint [unique]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "photos" jsonb
  "version" bigint [not null]
  "first_approved_at" timestamptz
  "moderation_source" varchar(16)
  "moderation_verdict" varchar(16)
  "moderation_categories" jsonb
  "moderation_reason" varchar(500)
  "moderation_checked_at" timestamptz
  Note: "0 dòng - nhóm: Đánh giá sản phẩm"
}

Table role_permissions {
  "role_id" varchar(50) [pk, not null]
  "permission" varchar(100) [pk, not null]
  Note: "65 dòng - nhóm: Quản trị & phân quyền"
}

Table site_settings {
  "id" uuid [pk, not null]
  "setting_key" varchar(255) [unique, not null]
  "setting_value" text [not null]
  "setting_group" varchar(100) [not null]
  "is_public" bool [not null]
  "description" text
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "setting_value_en" text
  Note: "59 dòng - nhóm: Nội dung & giao diện website"
}

Table sliders {
  "id" varchar(64) [pk, not null]
  "sort_order" int [unique, not null]
  "location" varchar(64) [unique, not null]
  "desktop_image" json
  "mobile_image" json
  "product_id" varchar(64)
  "external_link" text
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "is_active" bool [not null]
  Note: "5 dòng - nhóm: Nội dung & giao diện website"
}

Table stock_movements {
  "id" uuid [pk, not null]
  "product_variant_id" varchar(255)
  "movement_type" varchar(32) [not null]
  "quantity_delta" int [not null]
  "quantity_before" int [not null]
  "quantity_after" int [not null]
  "reference_type" varchar(64)
  "reference_id" uuid
  "note" text
  "admin_id" uuid
  "created_at" timestamptz [not null]
  "product_id" varchar(255)
  Note: "3 dòng - nhóm: Sản phẩm & danh mục"
}

Table tmp_p {
  "p" text
  Note: "547 dòng - nhóm: Kỹ thuật & vận hành"
}

