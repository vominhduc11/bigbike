# =============================================================
# BigBike dev infra — root .env.example
# Copy to .env and fill real values. NEVER commit .env.
# =============================================================

# --- PostgreSQL ---
POSTGRES_DB=bigbike
POSTGRES_USER=bigbike
POSTGRES_PASSWORD=bigbike_dev_only

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_only
MINIO_BUCKET=bigbike-media
# Private customer chat images. Must never use the public media bucket or anonymous-read policy.
MINIO_CHAT_PRIVATE_BUCKET=bigbike-chat-private

# --- Spring Boot ---
# Use "dev" for local development (skips strict JWT secret validation, loads seed data).
# Use "prod" for staging/production (requires BIGBIKE_JWT_SECRET to be non-default, >= 32 chars).
# NOTE: BIGBIKE_DB_*, MINIO_ENDPOINT for backend are wired by docker-compose.yaml
# using POSTGRES_* + Docker network hostnames (postgres/minio). For local non-Docker
# dev (mvn spring-boot:run), see bigbike-backend/.env.local.
SPRING_PROFILES_ACTIVE=dev
# Local dev databases may contain db/migration-dev history (V1001+), so allow
# newer prod migrations (V368+) to run out of order.
SPRING_FLYWAY_OUT_OF_ORDER=true

# Tài liệu API tự sinh (springdoc) + Swagger UI tại http://localhost:8080/swagger-ui.html
# TẮT mặc định ở mọi profile: bản đồ toàn bộ API là thông tin trinh sát cho kẻ tấn công, và
# /v3/api-docs/** + /swagger-ui/** không yêu cầu đăng nhập. Chỉ bật trên máy lập trình viên.
# Profile prod ép về false trong application-prod.properties — biến này không mở được ở prod.
# Bản sinh tự động nằm ở /v3/api-docs/live; /v3/api-docs vẫn phục vụ hợp đồng biên tập tay.
BIGBIKE_API_DOCS_ENABLED=false

# Seed admin password (used by DataInitializer on first run when DB is empty).
# Default in application-dev.properties: admin-dev-change-me
BIGBIKE_SEED_ADMIN_PASSWORD=admin-dev-change-me

# REQUIRED for SPRING_PROFILES_ACTIVE=prod — must be >= 32 chars, not the default value.
# Generate a secure value: openssl rand -base64 48
BIGBIKE_JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_32_CHARS

# CORS — comma-separated exact origins, no wildcards, no trailing slashes
BIGBIKE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Cookie Domain for the customer cookies (bb_session / bb_csrf / bb_refresh / bb_guest_id).
# Leave BLANK for local dev: web (:3000) and API (:8080) share the host `localhost`, and
# cookies ignore the port, so host-only cookies already reach both.
# Set it on any deployment where the storefront and the API are different hosts of the same
# site — e.g. BIGBIKE_COOKIES_DOMAIN=.bigbike.vn for bigbike.vn + api.bigbike.vn. Without it
# the storefront cannot read bb_csrf and every customer mutation fails with 403.
BIGBIKE_COOKIES_DOMAIN=

# Reverse-proxy IPs trusted to set X-Forwarded-For (per-IP rate limiting). Comma-separated;
# each entry is an exact IP or a NARROW private CIDR (minimum IPv4 /24, IPv6 /64).
# Do not use broad Docker ranges such as 172.16.0.0/12 and do not add a public CDN/LB CIDR
# until its exact address chain is verified. For the local Docker bridge, use the narrow
# network CIDR shown by `docker network inspect`. The `bigbike-dev` bridge hands out
# 172.20.0.x, so 172.20.0.0/24 is the narrow entry that matches it — a /16 or /12 is
# rejected at startup and the backend will not boot.
# Production must replace this with its verified ingress/container hop(s).
BIGBIKE_TRUSTED_PROXIES=127.0.0.1,::1,172.20.0.0/24

# --- Distributed rate limiting ---
# Staging/production may use a managed HA Redis-compatible endpoint with TLS/ACL
# (rediss://...). Plaintext redis:// is accepted only for an in-network host — a Compose
# service name or a private address — and never for a publicly routable one. The backend
# fails startup in the prod profile unless store=redis and the HMAC secret below has at
# least 32 characters.
# Host/port below target the Redis health indicator; keep them on the same instance as the
# URL, otherwise /actuator/health reports DOWN and the container is killed as unhealthy.
BIGBIKE_REDIS_HOST=redis
BIGBIKE_REDIS_PORT=6379
BIGBIKE_RATE_LIMIT_ENABLED=true
BIGBIKE_RATE_LIMIT_STORE=redis
BIGBIKE_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
BIGBIKE_RATE_LIMIT_REDIS_TIMEOUT_MS=100
# Generate independently from JWT/internal tokens: openssl rand -base64 48
BIGBIKE_RATE_LIMIT_HMAC_SECRET=
# Bounded emergency fallback only; not shared between replicas.
BIGBIKE_RATE_LIMIT_FALLBACK_MAX_ENTRIES=50000
# Inactive local/emergency keys expire after this many refill windows; it is not a request limit.
BIGBIKE_RATE_LIMIT_LOCAL_ENTRY_TTL_MULTIPLIER=2
# Optional approved per-tier override example (units: s, m, h). Leave all unset unless a
# change has an owner-approved expiry and staging load-test evidence.
# BIGBIKE_RATE_LIMIT_TIERS_LOGIN_LIMIT=5
# BIGBIKE_RATE_LIMIT_TIERS_LOGIN_WINDOW=1m

# Frontend public URLs — baked into the client bundle at build time (NEXT_PUBLIC_ prefix).
# For production set these to the real public URLs before running docker compose build.
# e.g. NEXT_PUBLIC_API_BASE_URL=https://api.bigbike.vn
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin app origin — the ONLY origin allowed to embed the storefront live-preview
# iframe (/preview/*) and the origin checked on postMessage in the preview route.
# Must match where the admin app is served. Prod: https://admin.bigbike.vn
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:4000
# Admin (Vite) — storefront origin for "view on site" links AND the product
# live-preview iframe src. Baked into the admin bundle at build time. Prod: https://bigbike.vn
VITE_STOREFRONT_BASE_URL=http://localhost:3000
# Optional comma-separated legacy MinIO origins that admin should rewrite via /media-proxy/.
# Leave blank unless existing media records still contain an older origin.
VITE_MINIO_EXTRA_ORIGINS=

# Server-side canonical site URL (used by Next.js for metadata/og:url/sitemap).
# Override in production: BIGBIKE_SITE_URL=https://bigbike.vn
BIGBIKE_SITE_URL=http://localhost:3000

# --- On-demand revalidation (backend → Next.js cache purge) ---
# Generate: openssl rand -base64 32
WEB_REVALIDATE_SECRET=CHANGE_ME_RANDOM_SECRET
# URL the backend calls to purge Next.js cache (must include /api/revalidate path).
# Backend runs inside Docker → must use the compose SERVICE NAME (bigbike-web), NOT localhost
# (localhost inside the container points at the backend itself → Connection refused, ISR never refreshes).
# For a host-run `npm run dev` (port 3001) add: ,http://host.docker.internal:3001/api/revalidate
WEB_REVALIDATE_URL=http://bigbike-web:3000/api/revalidate
# Optional. Blank = derive /_internal/redirect-cache/clear from every WEB_REVALIDATE_URL.
WEB_REDIRECT_CACHE_CLEAR_URL=
# Multi-replica fail-safe. Set to the number of web replicas so backend startup fails
# unless WEB_REVALIDATE_URL (and redirect clear URLs, when explicit) cover every replica.
WEB_REVALIDATE_EXPECTED_REPLICAS=0

# --- Internal redirect lookup (bigbike-web proxy.ts -> bigbike-backend) ---
# Leave empty in local dev (backend dev profile sets bigbike.internal.allow-open=true).
# REQUIRED in staging/prod - generate once, set the SAME value on both vars:
#   openssl rand -base64 32
BIGBIKE_INTERNAL_TOKEN=
INTERNAL_API_TOKEN=

# --- Transactional email (SMTP) ---
# Leave BIGBIKE_MAIL_HOST empty to disable mail delivery (the backend still requires
# BIGBIKE_MAIL_ADMIN so internal notification routing is never silently undefined).
# For Gmail: host=smtp.gmail.com, port=587, password = App Password (NOT account password).
# Generate App Password at: https://myaccount.google.com/apppasswords
BIGBIKE_MAIL_HOST=
BIGBIKE_MAIL_PORT=587
BIGBIKE_MAIL_USERNAME=
BIGBIKE_MAIL_PASSWORD=
BIGBIKE_MAIL_SMTP_AUTH=true
BIGBIKE_MAIL_STARTTLS=true
BIGBIKE_MAIL_FROM=no-reply@bigbike.vn
BIGBIKE_MAIL_FROM_NAME=BigBike
# Required shared mailbox for internal new-order and staff-handoff alerts.
# There is no runtime fallback; the backend stops at startup if this is blank/invalid.
BIGBIKE_MAIL_ADMIN=bigbikevnshop@gmail.com
BIGBIKE_MAIL_VERIFY_BASE_URL=http://localhost:3000/xac-nhan-email
BIGBIKE_MAIL_RESET_BASE_URL=http://localhost:3000/quen-mat-khau
# Admin invite set-password page (in bigbike-admin). Local: http://localhost:4000/accept-invite
BIGBIKE_MAIL_ADMIN_INVITE_BASE_URL=https://admin.bigbike.vn/accept-invite

# --- Optional Telegram new-order alert ---
# Leave the bot token or chat ID blank to keep this channel disabled.
BIGBIKE_TELEGRAM_BOT_TOKEN=
BIGBIKE_TELEGRAM_CHAT_ID=
BIGBIKE_TELEGRAM_API_BASE_URL=
# PHẢI là số, KHÔNG được để trống. docker-compose.yaml luôn truyền biến này vào
# container (`${BIGBIKE_TELEGRAM_TIMEOUT_SECONDS:-}`), nên giá trị rỗng sẽ ghi đè
# default 5 trong application.properties và backend chết ngay lúc khởi động
# (NumberFormatException: For input string: ""). Sự cố đo được 2026-09-05.
BIGBIKE_TELEGRAM_TIMEOUT_SECONDS=5

# --- Automatic post-purchase review invitations ---
# Only emergency switch. Delay is fixed at 7 days and the daily attempt cap is fixed at 20.
# Set false and redeploy/restart the backend to close the active campaign and skip pending mail.
BIGBIKE_REVIEW_INVITATION_ENABLED=true

# --- Backend public URLs (used in transactional email templates + admin links) ---
# Override in production, e.g. BIGBIKE_SITE_BASE_URL=https://bigbike.vn
BIGBIKE_SITE_BASE_URL=https://bigbike.vn
BIGBIKE_ADMIN_BASE_URL=https://admin.bigbike.vn

# Media URL allowlist anchor — admin write paths reject media URLs not under this base.
# Leave empty to derive from MINIO_ENDPOINT/MINIO_BUCKET (good for local dev).
# Production example: BIGBIKE_MEDIA_PUBLIC_BASE_URL=https://cdn.bigbike.vn/uploads
BIGBIKE_MEDIA_PUBLIC_BASE_URL=

# --- Social login (OAuth2 — Google & Facebook) ---
# Leave client id/secret blank to keep social login disabled (buttons render but the
# flow returns an "oauth" error). See docs/engineering/INTEGRATION_GUIDE.md for provider setup.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
# Backend base URL the providers redirect their callbacks to (must match the redirect
# URI registered in Google Cloud Console / Facebook for Developers).
OAUTH_CALLBACK_BASE_URL=http://localhost:8080
# Storefront URL the callback redirects the browser to after a successful login.
OAUTH_WEB_SUCCESS_URL=http://localhost:3000

# --- Frontend (bigbike-web) runtime ---
# In-process redirect lookup cache TTL in seconds (0 = disabled).
BIGBIKE_REDIRECT_CACHE_TTL_SECONDS=300

# Google Tag Manager. Production: GTM-5BKZL3K. Staging: leave empty or use a dedicated test container.
NEXT_PUBLIC_GTM_ID=

# Sentry — set DSN to enable error reporting. AUTH_TOKEN/ORG/PROJECT are needed only at build time
# for source-map upload (CI/build server). Leave all empty in dev.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Static outage pages (host) ---
# Consumed by deploy/maintenance/render-fallback-pages.sh, which regenerates the pages
# nginx serves via `error_page 502 503 504` when a container is genuinely unreachable.
# Run it at deploy time so the contact details on those pages stay current.
BIGBIKE_MAINTENANCE_STATIC_ROOT=/var/www/bigbike-static/maintenance
BIGBIKE_MAINTENANCE_API_URL=http://127.0.0.1:8080

# --- E2E safety switch ---
# Chỉ dùng trong lần nghiệm thu có chủ đích: kịch bản editor sẽ hết giờ sau khi
# tạo sản phẩm ở lần thử đầu, để xác nhận worker guard vẫn dọn được bằng ID.
# Để 0 hoặc bỏ trống khi chạy E2E thông thường.
E2E_FORCE_EDITOR_TIMEOUT=0

# --- Shared Google Gemini credential (backend only) ---
# Used independently by review moderation and the BigBike sales assistant. It never reaches
# browser code or site_settings. See REVIEW_RULE_012/013 and CHAT_RULE_001-014.
#
# Leaving the key empty is a supported state: every review is marked "skipped" and stays in
# Pending exactly as it does today. The on/off switch and the four violation categories are
# NOT here — they live in Admin > Settings so the shop can change them without a deploy.
# Never commit a real key; never move it into site_settings.
#
# NOTE: this is the same key name the removed VI->EN auto-translation used. Translation is
# still manual and is NOT coming back (TRANSLATION_RULE_001/002).
GEMINI_API_KEY=
# Model used for the classification call. gemini-2.5-flash is the default and is the cheap
# tier; changing it is a cost/accuracy tradeoff for the shop owner, not a code change.
BIGBIKE_REVIEW_MODERATION_MODEL=gemini-2.5-flash
# Per-call ceiling. Exceeding it marks the review "skipped" and leaves it in Pending.
BIGBIKE_REVIEW_MODERATION_TIMEOUT_SECONDS=20
# BigBike Assistant always uses this one fixed sales-assistant model. It is server
# configuration, not an Admin setting; review moderation above remains independent.
BIGBIKE_CHAT_MODEL=gemini-3.7-flash
BIGBIKE_CHAT_TIMEOUT_SECONDS=65
