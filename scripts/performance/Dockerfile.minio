# Same official release binary as the shop; public registry image is unavailable.
# CI only: runtime base differs from the shipping UBI-micro image (documented).
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 2 --max-time 180 \
      https://github.com/minio/minio/releases/download/RELEASE.2025-04-22T22-12-26Z/minio.linux-amd64.RELEASE.2025-04-22T22-12-26Z \
      --output /usr/local/bin/minio \
    && echo '53e2a2cb16c5366ea6fbbc479c19ddb4c6a0948273e752f740fb1fbf27bb817c  /usr/local/bin/minio' | sha256sum --check --strict \
    && chmod 755 /usr/local/bin/minio \
    && minio --version | grep -F 'RELEASE.2025-04-22T22-12-26Z'
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/minio"]
