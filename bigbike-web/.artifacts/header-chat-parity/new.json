{
  "desktop": {
    "float": {
      "position": "relative",
      "direction": "ltr",
      "fontFamily": "Arial, sans-serif",
      "display": "flex",
      "flexDirection": "column-reverse",
      "alignItems": "flex-end"
    },
    "title": {
      "display": "block",
      "backgroundColor": "rgb(0, 191, 255)",
      "color": "rgb(0, 0, 0)",
      "fontSize": "13px",
      "fontFamily": "Arial, sans-serif",
      "paddingTop": "2px",
      "paddingLeft": "5px",
      "borderRadius": "0px",
      "whiteSpace": "nowrap",
      "position": "relative",
      "bottom": "42px",
      "right": "70px"
    },
    "container": {
      "position": "relative",
      "display": "block",
      "transform": "none"
    },
    "mask": {
      "position": "absolute",
      "top": "-8px",
      "left": "-8px",
      "width": "82px",
      "height": "82px",
      "minWidth": "66px",
      "borderRadius": "50%",
      "backgroundColor": "rgb(0, 191, 255)",
      "opacity": "0.2",
      "pointerEvents": "none"
    },
    "block": {
      "width": "66px",
      "height": "66px",
      "borderRadius": "50%",
      "overflow": "hidden",
      "boxSizing": "border-box",
      "backgroundColor": "rgba(0, 0, 0, 0)"
    },
    "innerBlock": {
      "position": "relative",
      "width": "66px",
      "height": "66px",
      "borderRadius": "50%",
      "backgroundColor": "rgb(0, 191, 255)",
      "color": "rgb(0, 0, 0)",
      "borderTopStyle": "none",
      "borderTopWidth": "0px",
      "cursor": "pointer",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "center",
      "boxSizing": "border-box"
    },
    "iconWrap": {
      "position": "relative",
      "flexGrow": "1",
      "width": "66px",
      "height": "66px"
    },
    "iconItem": {
      "position": "absolute",
      "top": "0px",
      "left": "0px",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "center",
      "width": "66px",
      "height": "66px",
      "transitionProperty": "opacity",
      "transitionDuration": "0.6s",
      "opacity": "1"
    },
    "closeItem": {
      "position": "absolute",
      "top": "0px",
      "left": "0px",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "center",
      "width": "66px",
      "height": "66px",
      "transitionProperty": "opacity",
      "transitionDuration": "0.6s",
      "opacity": "0"
    },
    "openInner": {
      "position": "relative",
      "width": "66px",
      "height": "66px",
      "borderRadius": "50%",
      "backgroundColor": "rgb(0, 191, 255)",
      "color": "rgb(0, 0, 0)",
      "borderTopStyle": "none",
      "borderTopWidth": "0px",
      "cursor": "pointer",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "center",
      "boxSizing": "border-box"
    },
    "openContainer": {
      "position": "relative",
      "display": "inline-block",
      "transform": "none"
    },
    "openIconItem": {
      "position": "absolute",
      "top": "0px",
      "left": "0px",
      "display": "none",
      "alignItems": "center",
      "justifyContent": "center",
      "width": "100%",
      "height": "100%",
      "transitionProperty": "opacity",
      "transitionDuration": "0.6s",
      "opacity": "1"
    },
    "openClose": {
      "position": "absolute",
      "top": "0px",
      "left": "0px",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "center",
      "width": "66px",
      "height": "66px",
      "transitionProperty": "opacity",
      "transitionDuration": "0.6s",
      "opacity": "1"
    },
    "panelItem": {
      "display": "block",
      "color": "rgb(51, 51, 51)",
      "overflow": "hidden",
      "textDecorationLine": "none",
      "paddingTop": "8px",
      "paddingLeft": "16px"
    },
    "panelIcon": {
      "cssFloat": "left",
      "marginRight": "5px"
    },
    "panelLabel": {
      "height": "40px",
      "lineHeight": "40px",
      "color": "rgb(51, 51, 51)",
      "marginTop": "0px",
      "fontSize": "17.6px",
      "fontFamily": "Arial, sans-serif"
    }
  },
