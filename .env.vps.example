# =============================================================
# BigBike — VPS environment file (.env.vps)
# Copy to .env.vps and fill real values. NEVER commit .env.vps.
#
# Run on the VPS with:
#   docker compose --env-file .env.vps up -d --build
#
# IMPORTANT: docker compose loads ONLY ONE env-file. This file must be
# COMPLETE (every required var below), it does NOT merge with .env.
#
# IMPORTANT: every NEXT_PUBLIC_* / VITE_* value is baked into the web/admin
# bundle at BUILD time. After changing any of them you MUST rebuild
# (the `--build` flag above), a plain restart will keep the old links.
#
# Replace <DOMAIN> everywhere with your domain (e.g. bigbike.vn). The layout
# assumed here — and used in production since 2026-08-06 — is:
#   web   -> https://<DOMAIN>            admin -> https://admin.<DOMAIN>
#   api   -> https://api.<DOMAIN>        media -> https://media.<DOMAIN>
# nginx on the host terminates TLS and proxies to the containers, whose ports
# are bound to 127.0.0.1 only. Never point these vars at the server's public
# IP:port — that bypasses nginx, serves the shop over plain http, and breaks
# the admin live-preview iframe (CSP frame-ancestors is origin-exact).
# =============================================================

# --- PostgreSQL ---
POSTGRES_DB=bigbike
POSTGRES_USER=bigbike
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=bigbike-media

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=prod
BIGBIKE_SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# REQUIRED for prod profile — >= 32 chars, generate: openssl rand -base64 48
BIGBIKE_JWT_SECRET=CHANGE_ME_RANDOM_48_CHARS
# Session cookies over HTTPS only. Keep true whenever the stack is behind TLS.
BIGBIKE_COOKIES_SECURE=true
# REQUIRED once the storefront and the API live on different hosts (bigbike.vn vs
# api.bigbike.vn). Leading dot = share the cookie across the whole site. Without it the
# cookies are host-only: the storefront cannot read bb_csrf, so add-to-cart, checkout,
# profile edits and reviews all fail with 403 CSRF_INVALID, and the /tai-khoan/ guard in
# bigbike-web bounces logged-in customers straight back to the login page.
BIGBIKE_COOKIES_DOMAIN=.<DOMAIN>
# Leave blank on a fresh deployment. Set it only when the database already ran
# migrations that the active profile no longer ships (e.g. a stack that ran
# classpath:db/migration-dev before switching to prod) — otherwise Flyway aborts
# startup on those entries.
#   *:missing  -> applied version is BELOW the highest version on the classpath
#   *:future   -> applied version is ABOVE it (db/migration-dev uses V1001+,
#                 which outranks every prod migration, so this one is required)
# When in doubt use both: SPRING_FLYWAY_IGNORE_MIGRATION_PATTERNS=*:missing,*:future
SPRING_FLYWAY_IGNORE_MIGRATION_PATTERNS=
# Set to true on a stack whose history contains higher-numbered migrations than
# the ones still shipping (same db/migration-dev situation as above). Without it
# every NEW prod migration is classified "ignored" and silently never runs.
SPRING_FLYWAY_OUT_OF_ORDER=false

# CORS — must list the browser origins of web + admin (no trailing slash).
BIGBIKE_CORS_ALLOWED_ORIGINS=https://<DOMAIN>,https://www.<DOMAIN>,https://admin.<DOMAIN>

# Reverse-proxy / Docker bridge IPs trusted for X-Forwarded-For. Behind Docker,
# include the bridge subnet so per-IP rate limiting works.
BIGBIKE_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# --- bigbike-web: the ONLY links that truly change vs local ---
# The customer's browser calls the backend + MinIO DIRECTLY, so these must be
# public https addresses, NOT localhost and NOT the raw server IP.
NEXT_PUBLIC_API_BASE_URL=https://api.<DOMAIN>
NEXT_PUBLIC_SITE_URL=https://<DOMAIN>
NEXT_PUBLIC_ADMIN_ORIGIN=https://admin.<DOMAIN>
BIGBIKE_SITE_URL=https://<DOMAIN>
# Browser-reachable MinIO origin baked into the web CSP + legacy image URLs.
BIGBIKE_LEGACY_UPLOADS_BASE=https://media.<DOMAIN>/bigbike-media/wp-uploads
# Server-side (inside Docker) MinIO — stays the internal network name.
BIGBIKE_MEDIA_INTERNAL_URL=http://minio:9000/bigbike-media/wp-uploads

# --- bigbike-admin ---
# Admin calls /api/v1 (relative) so its API base never changes across envs.
# Only the live-preview iframe needs the public storefront URL. It must match
# NEXT_PUBLIC_SITE_URL exactly — bigbike-web only allows NEXT_PUBLIC_ADMIN_ORIGIN
# to embed /preview/*, and an origin mismatch shows up as a blank preview pane.
VITE_STOREFRONT_BASE_URL=https://<DOMAIN>
# Optional comma-separated legacy MinIO origins still present in stored media URLs.
# Leave blank for a clean deployment; do not add retired hosts unless records require them.
VITE_MINIO_EXTRA_ORIGINS=

# --- On-demand revalidation (backend -> Next.js cache purge, internal) ---
WEB_REVALIDATE_SECRET=CHANGE_ME_RANDOM_SECRET
WEB_REVALIDATE_URL=http://bigbike-web:3000/api/revalidate/
# Blank = derive /_internal/redirect-cache/clear from every WEB_REVALIDATE_URL.
WEB_REDIRECT_CACHE_CLEAR_URL=
# Single-replica default. For N web replicas without shared ISR cache, set N and list
# every replica in WEB_REVALIDATE_URL so stale caches fail fast instead of going silent.
WEB_REVALIDATE_EXPECTED_REPLICAS=1

# --- Internal redirect lookup (bigbike-web proxy.ts -> bigbike-backend) ---
# Generate: openssl rand -base64 32 (same value for both vars). Required under the
# prod profile: blank means every legacy .html URL loses its 301 redirect.
BIGBIKE_INTERNAL_TOKEN=CHANGE_ME_RANDOM_SECRET
INTERNAL_API_TOKEN=CHANGE_ME_RANDOM_SECRET

# --- Backend public URLs (emails + admin links) ---
BIGBIKE_SITE_BASE_URL=https://<DOMAIN>
BIGBIKE_ADMIN_BASE_URL=https://admin.<DOMAIN>
# Browser-reachable media allowlist anchor.
BIGBIKE_MEDIA_PUBLIC_BASE_URL=https://media.<DOMAIN>/bigbike-media

# --- Transactional email (SMTP) — leave host empty to disable ---
BIGBIKE_MAIL_HOST=
BIGBIKE_MAIL_PORT=587
BIGBIKE_MAIL_USERNAME=
BIGBIKE_MAIL_PASSWORD=
BIGBIKE_MAIL_SMTP_AUTH=true
BIGBIKE_MAIL_STARTTLS=true
BIGBIKE_MAIL_FROM=no-reply@bigbike.vn
BIGBIKE_MAIL_FROM_NAME=BigBike
BIGBIKE_MAIL_ADMIN=info@bigbike.vn
BIGBIKE_MAIL_VERIFY_BASE_URL=https://<DOMAIN>/xac-nhan-email
BIGBIKE_MAIL_RESET_BASE_URL=https://<DOMAIN>/quen-mat-khau
BIGBIKE_MAIL_ADMIN_INVITE_BASE_URL=https://admin.<DOMAIN>/accept-invite

# --- Social login (OAuth2) — blank keeps it disabled ---
# Authorized redirect URI to register with Google/Facebook:
#   https://api.<DOMAIN>/api/v1/customer/auth/oauth/{google|facebook}/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=https://api.<DOMAIN>
OAUTH_WEB_SUCCESS_URL=https://<DOMAIN>

# --- Frontend runtime ---
BIGBIKE_REDIRECT_CACHE_TTL_SECONDS=300
NEXT_PUBLIC_GTM_ID=

# --- Sentry — blank disables ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Static outage pages (host) ---
# Consumed by deploy/maintenance/render-fallback-pages.sh. Regenerate on every deploy and
# whenever contact settings change: a static file cannot read the DB at the moment the
# stack is down, which is exactly when nginx serves it.
BIGBIKE_MAINTENANCE_STATIC_ROOT=/var/www/bigbike-static/maintenance
BIGBIKE_MAINTENANCE_API_URL=http://127.0.0.1:8080

# --- Admin maintenance lock (backend) ---
# ADMIN PANEL only — the storefront is never taken down and customers can always order.
# Toggled from the admin UI by the DEVELOPER role; there is no host-side switch any more.
# Break-glass: set to false to disable the lock entirely (see DEPLOYMENT_GUIDE.md).
BIGBIKE_MAINTENANCE_LOCK_ENABLED=true
